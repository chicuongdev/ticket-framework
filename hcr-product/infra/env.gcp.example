# ============================================================================
# /etc/hcr/env — env file chung cho 3 service trên hcr-app VM
# ----------------------------------------------------------------------------
# Deploy:
#   scp hcr-product/infra/env.gcp.example hcr-app:~/env
#   ssh hcr-app "sudo mkdir -p /etc/hcr && sudo mv ~/env /etc/hcr/env"
#
# WARN: file nay duoc reference boi 3 unit file (hcr-{order,inventory,payment}.service)
#       qua directive `EnvironmentFile=/etc/hcr/env`. Sua xong PHAI restart 3 service.
#
# DB_NAME khong o day — 3 service tro 3 DB khac nhau, set per-service trong unit file
# (vd `Environment="DB_NAME=order_db"`).
# ============================================================================

# Switch prototype: doi gia tri nay roi restart 3 service.
# Gia tri hop le: p1 | p2 | p3
ACTIVE_PROTOTYPE=p1

# ----------------------------------------------------------------------------
# Data layer — hcr-data VM (Postgres + Redis chung 1 VM, theo Path A)
# ----------------------------------------------------------------------------
DB_HOST=10.20.0.3
DB_PORT=5432
DB_USER=hcr
DB_PASS=hcr
REDIS_HOST=10.20.0.3
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# Bus + observability — hcr-busobs VM
# ----------------------------------------------------------------------------
KAFKA_BOOTSTRAP=10.20.0.4:9092
ZIPKIN_ENDPOINT=http://10.20.0.4:9411/api/v2/spans

# ----------------------------------------------------------------------------
# Inter-service URL — ms-payment cung VM voi ms-order (cung tren hcr-app)
# ----------------------------------------------------------------------------
MS_PAYMENT_URL=http://localhost:8083
